# Copy this file to .env.local and fill in the values.
# .env.local is never committed to Git.
#
# For local development, run `npx supabase start` and copy the values it
# prints: "API URL" and "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The art screen saver's paintings: the folder holding General, Spring,
# Summer, Autumn, Winter, holiday and birthday folders. Leave it blank if
# there's no art yet. On Windows, use forward slashes, like
# ART_FOLDER=C:/Users/you/Desktop/Art Screensaver
ART_FOLDER=
